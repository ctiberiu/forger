# Names only — never commit values. Documented in docs/setup.md.

# Neon Postgres connection string
DATABASE_URL=

# Vercel Blob public store credentials
BLOB_READ_WRITE_TOKEN=

# Meta app credentials for the OAuth exchange
IG_APP_ID=
IG_APP_SECRET=

# OAuth callback
IG_REDIRECT_URI=

# Telegram Bot API
TELEGRAM_BOT_TOKEN=

# Operator's chat for notifications
TELEGRAM_CHAT_ID=

# Verifies inbound Telegram webhooks
TELEGRAM_WEBHOOK_SECRET=

# Authenticates Vercel Cron invocations
CRON_SECRET=

# Authenticates webhook_push callers
TRIGGER_API_KEY=
