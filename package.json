{
  "name": "postforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:boundary": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/check-boundary.ts",
    "db:seed": "node --disable-warning=ExperimentalWarning --experimental-strip-types --env-file-if-exists=.env.local scripts/db-seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --disable-warning=ExperimentalWarning --experimental-strip-types --env-file-if-exists=.env.local lib/db/migrate.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "drizzle-orm": "0.45.2",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@types/node": "22.19.2",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "unrs-resolver"
    ]
  }
}
